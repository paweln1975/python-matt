@startuml
'https://plantuml.com/class-diagram

abstract class AbstractList
abstract AbstractCollection
interface List
interface Collection

List <|-- AbstractList
Collection <|-- AbstractCollection

Collection <|- List
AbstractCollection <|- AbstractList
AbstractList <|-- ArrayList

class ArrayList {
Object[] elementData
size()
}

class Account {
}
class User {
    {field} firstname: str
    {field} lastname: str
    {field} age: int
    - {field} status: bool
    .. static ..
    {static} AGE_MIN: int
    {static} AGE_MAX: int
    .. methods ..
    login(): bool

}

Account <|-- User

enum TimeUnit {
DAYS
HOURS
MINUTES
}

@enduml